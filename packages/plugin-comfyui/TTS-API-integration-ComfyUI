## Quick Start

### Minimal Integration

```python
from simple_tts_client import generate_tts_simple, wait_for_tts_completion

def elizaos_tts(text: str):
    # Generate TTS
    result = generate_tts_simple(text=text)
    
    if result['success']:
        # Wait for completion
        completion = wait_for_tts_completion(result['prompt_id'])
        
        if completion['success']:
            return completion['tts_urls'][0]  # Return first audio URL
        else:
            return f"TTS failed: {completion.get('error')}"
    else:
        return f"TTS failed: {result.get('error')}"

# Usage
audio_url = elizaos_tts("Hello, how are you today?")
print(f"Audio available at: {audio_url}")
```

### Advanced Integration

```python
import asyncio
from simple_tts_client import generate_tts_simple, wait_for_tts_completion

async def elizaos_advanced_tts(text: str, voice_file: str = "en_sample.wav"):
    """
    Advanced TTS generation for ElizaOS with full error handling
    """
    try:
        # Generate TTS
        result = generate_tts_simple(
            text=text,
            reference_audio=voice_file,
            language="en",
            temperature=0.7,
            speed=1.0
        )
        
        if not result['success']:
            return {
                "success": False,
                "error": result.get('error', 'TTS generation failed'),
                "audio_url": None
            }
        
        # Wait for completion
        completion = wait_for_tts_completion(
            prompt_id=result['prompt_id'],
            max_wait=300
        )
        
        if completion['success'] and completion['tts_urls']:
            return {
                "success": True,
                "error": None,
                "audio_url": completion['tts_urls'][0]
            }
        else:
            return {
                "success": False,
                "error": completion.get('error', 'TTS completion failed'),
                "audio_url": None
            }
            
    except Exception as e:
        return {
            "success": False,
            "error": f"Exception: {str(e)}",
            "audio_url": None
        }

# Usage in ElizaOS
async def handle_user_tts_request(user_text: str):
    result = await elizaos_advanced_tts(user_text)
    
    if result['success']:
        return f"TTS generated successfully! Audio: {result['audio_url']}"
    else:
        return f"TTS generation failed: {result['error']}"
```

