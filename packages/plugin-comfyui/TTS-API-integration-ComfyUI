```

### Async Integration for ElizaOS

```python
import asyncio
from simple_tts_client import generate_tts_simple, wait_for_tts_completion

async def elizaos_tts_generate(text: str, voice_file: str = "en_sample.wav"):
    """
    ElizaOS plugin function to generate TTS
    """
    try:
        # Start TTS generation
        result = generate_tts_simple(
            text=text,
            reference_audio=voice_file,
            language="en",
            temperature=0.7,
            speed=1.0
        )
        
        if not result['success']:
            return {
                "error": result.get('error', 'TTS generation failed'),
                "details": result.get('details', 'Unknown error')
            }
        
        # Wait for completion
        completion = wait_for_tts_completion(
            prompt_id=result['prompt_id'],
            max_wait=300  # 5 minutes timeout
        )
        
        if completion['success'] and completion['tts_urls']:
            return {
                "success": True,
                "audio_urls": completion['tts_urls'],
                "message": "TTS generation completed successfully"
            }
        else:
            return {
                "error": "TTS generation failed or timed out",
                "details": completion.get('error', 'Unknown error')
            }
            
    except Exception as e:
        return {
            "error": "Exception in TTS generation",
            "details": str(e)
        }

# Usage in ElizaOS
async def handle_tts_request(user_text: str):
    tts_result = await elizaos_tts_generate(user_text)
    
    if tts_result.get('success'):
        audio_urls = tts_result['audio_urls']
        # ElizaOS can now play the audio or return URLs to user
        return f"TTS generated! Audio available at: {audio_urls[0]}"
    else:
        return f"TTS generation failed: {tts_result.get('error')}"
```

### Status Checking

```python
from simple_tts_client import get_tts_status_simple

# Check TTS status
status = get_tts_status_simple("your_prompt_id")

if status['success']:
    if status['status'] == 'completed':
        print(f"TTS completed! URLs: {status['tts_urls']}")
    elif status['status'] == 'running':
